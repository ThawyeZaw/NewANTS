{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ants-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "beta",
    "COOKIE_DOMAIN": ".the-ants.org",
    "BETTER_AUTH_URL": "https://ants-api.thawyezaw.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-ants-v2-db",
      "database_id": "08906524-156f-44b6-bc22-e8703c2dae2f",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "the-ants-assets"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
