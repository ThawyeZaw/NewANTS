{
  "name": "@ants/api",
  "version": "0.1.0",
  "private": true,
  "description": "Headless Hono Worker on Cloudflare Workers: Better Auth cross-subdomain SSO, R2 private asset proxy, Telegram Webhook & 5-min Cron Queue (https://api.the-ants.org)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate:local": "wrangler d1 migrations apply the-ants-v2-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply the-ants-v2-db --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@ants/calculator": "workspace:*",
    "@ants/db": "workspace:*",
    "@ants/shared-types": "workspace:*",
    "hono": "^4.7.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250310.0",
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.21.0",
    "typescript-eslint": "^8.25.0"
  }
}
