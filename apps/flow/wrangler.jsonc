{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ants-flow",
  "main": "cf-worker.mjs",
  "compatibility_date": "2025-03-01",
  "routes": [
    {
      "pattern": "flow.the-ants.org",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "API",
      "service": "ants-api"
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
