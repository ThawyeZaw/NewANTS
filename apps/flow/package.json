{
  "name": "@ants/flow",
  "version": "0.1.0",
  "private": true,
  "description": "Flow (by The ANTs) — Sleek Productivity App: Smart Timetable, Task Planner, Reminders & Pomodoro Timer (https://flow.the-ants.org)",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@ants/auth-client": "workspace:*",
    "@ants/db": "workspace:*",
    "@ants/shared-types": "workspace:*",
    "@ants/ui": "workspace:*",
    "lucide-react": "^0.487.0",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.14",
    "typescript-eslint": "^8.25.0"
  }
}
