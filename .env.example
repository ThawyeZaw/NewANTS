# ============================================================================
# The ANTs Ecosystem — Environment Template (.env.example)
# Copy to .env.local (for Next.js apps) and apps/api/.dev.vars (for Wrangler)
# NEVER commit real secrets to Git.
# ============================================================================

# Canonical URLs (Local Dev Defaults)
NEXT_PUBLIC_ORG_URL="http://localhost:3000"
NEXT_PUBLIC_STUDY_URL="http://localhost:3001"
NEXT_PUBLIC_FLOW_URL="http://localhost:3002"
NEXT_PUBLIC_API_URL="http://localhost:8787"

# Production Equivalents:
# NEXT_PUBLIC_ORG_URL="https://the-ants.org"
# NEXT_PUBLIC_STUDY_URL="https://study.the-ants.org"
# NEXT_PUBLIC_FLOW_URL="https://flow.the-ants.org"
# NEXT_PUBLIC_API_URL="https://api.the-ants.org"

# Better Auth (apps/api)
BETTER_AUTH_SECRET="replace-with-32-byte-hex-secret"
BETTER_AUTH_URL="http://localhost:8787"
COOKIE_DOMAIN="localhost" # Set to ".the-ants.org" in production

# OAuth Providers (Optional, configured in apps/api)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Telegram Bot Integration (apps/api Cron & Webhook)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
