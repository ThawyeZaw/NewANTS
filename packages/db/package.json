{
  "name": "@ants/db",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare D1 (SQLite) + Drizzle ORM single source of truth schema and migrations",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ants/shared-types": "workspace:*",
    "drizzle-orm": "^0.40.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250310.0",
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.21.0",
    "typescript-eslint": "^8.25.0"
  }
}
